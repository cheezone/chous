{
  "name": "chous",
  "version": "0.2.0",
  "module": "dist/index.mjs",
  "type": "module",
  "private": false,
  "bin": {
    "chous": "dist/cli.mjs"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown  --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ./src",
    "prepare": "simple-git-hooks",
    "release": "pnpm run test && pnpm run build && changelogen --release --push --no-output --no-changelog",
    "sources": "tsx scripts/sources.ts",
    "sync": "tsx scripts/sync.ts",
    "docs": "tsx scripts/docs.ts",
    "corpus": "tsx scripts/corpus.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run typecheck",
    "commit-msg": "pnpm exec commitlint --edit"
  },
  "description": "Opinionated taste linter. No config: sniffs out what has rotten, not what is out of fashion.",
  "author": "Cheez Lin <https://cheez.tech>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheezone/chous.git"
  },
  "homepage": "https://github.com/cheezone/chous#readme",
  "bugs": {
    "url": "https://github.com/cheezone/chous/issues"
  },
  "keywords": [
    "lint",
    "linter",
    "taste",
    "opinionated",
    "zero-config",
    "filesystem",
    "file-structure",
    "cli"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.4.1",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.5.1",
    "@types/picomatch": "^4.0.3",
    "changelogen": "^0.6.2",
    "commitlint-plugin-function-rules": "^5.0.1",
    "i18next": "^27.2.6",
    "oxlint": "^1.82.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "public",
    "LICENSE",
    "docs/manifesto.md",
    "docs/rules.md",
    "docs/rules.zh.md",
    "docs/manifesto.zh.md"
  ],
  "dependencies": {
    "@manypkg/get-packages": "^3.1.0",
    "ignore": "^7.0.9",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17"
  }
}
